    {
      "name": "Create New Article",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Provera uspešnog kreiranja",
              "pm.test(\"Status kod je 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "// 2. Provera dinamičkog naslova",
              "pm.test(\"Članak ima ispravan dinamički naslov\", function () {",
              "    var jsonData = pm.response.json();",
              "    var ocekivaniNaslov = pm.variables.get(\"trenutni_naslov\");",
              "    pm.expect(jsonData.article.title).to.eql(ocekivaniNaslov);",
              "});",
              "",
              "// 3. BONUS: Čuvanje slug-a za brisanje u sledećem koraku",
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set(\"clean_article_slug\", jsonData.article.slug);",
              "}",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Uzimamo trenutno vreme u milisekundama (uvek je jedinstveno)",
              "var jedinstveniBroj = Date.now(); ",
              "",
              "// Pravimo dinamički naslov, npr. \"Test artickle - 1784885214\"",
              "var dinamickiNaslov = \"Test artickle - \" + jedinstveniBroj;",
              "",
              "// Čuvamo ovaj naslov u privremenu promenljivu",
              "pm.variables.set(\"trenutni_naslov\", dinamickiNaslov);",
              "",
              "// Cuvanje Slug broja",
              "// if (pm.response.code === 201) {",
              "//     var jsonData = pm.response.json();",
              "//     p.environment.set(\"clean_article_slug\", jsonData.article.slug);",
              "// }"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{auth_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"article\": {\n        \"title\": \"{{trenutni_naslov}}\",\n        \"description\": \"About Postman testing 3\",\n        \"body\": \"Yes :)\",\n        \"tagList\": []\n    }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://conduit-api.bondaracademy.com/api/articles/",
          "protocol": "https",
          "host": [
            "conduit-api",
            "bondaracademy",
            "com"
          ],
          "path": [
            "api",
            "articles",
            ""
          ]
        }
      },
      "response": []
    },
