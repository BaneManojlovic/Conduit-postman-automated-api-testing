  "item": [
    {
      "name": "Login Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response contains username in user data', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.user).to.have.property('username');",
              "});",
              "",
              "pm.test('Response contains token in user data', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.user.token).to.be.a('string');",
              "});",
              "",
              "// Saving token in Environment",
              "if (pm.response.code == 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set(\"auth_token\", jsonData.user.token);",
              "}",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"user\": {\n        \"email\": \"banetest@gmail.com\",\n        \"password\": \"Test123!\"\n    }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://conduit-api.bondaracademy.com/api/users/login",
          "protocol": "https",
          "host": [
            "conduit-api",
            "bondaracademy",
            "com"
          ],
          "path": [
            "api",
            "users",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET Current user",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Provera da li je profil uspešno učitan uz pomoć tokena",
              "pm.test(\"Autorizacija uspešna - Status je 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Provera da li se podaci poklapaju sa ulogovanim korisnikom",
              "pm.test(\"Učitan je ispravan korisnik\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.user.username).to.eql(\"BaneTest\");",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{auth_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://conduit-api.bondaracademy.com/api/user",
          "protocol": "https",
          "host": [
            "conduit-api",
            "bondaracademy",
            "com"
          ],
          "path": [
            "api",
            "user"
          ]
        }
      },
      "response": []
    },
