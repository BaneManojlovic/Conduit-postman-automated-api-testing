{
  "info": {
    "_postman_id": "5868956b-ee3a-489e-87a0-7d8ee2525e9a",
    "name": "Conduit API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "3587464"
  },
  "item": [
    {
      "name": "User Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code: 200 - Login Success\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response have user token\", function () {",
              "    const responseData = pm.response.json();",
              "    pm.expect(responseData.user.token).to.not.be.undefined;",
              "    // save token",
              "    pm.environment.set(\"user_token\", responseData.user.token);",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"user\": {\n        \"email\": \"banetest@gmail.com\",\n        \"password\": \"Test123!\"\n    }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://conduit-api.bondaracademy.com/api/users/login",
          "protocol": "https",
          "host": [
            "conduit-api",
            "bondaracademy",
            "com"
          ],
          "path": [
            "api",
            "users",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Current User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Provera uspešnog status koda",
              "pm.test(\"Status code: 200 - User data valid\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Provera strukture i ispravnosti podataka u odgovoru",
              "pm.test(\"Response contains valid user data\", function () {",
              "    const responseData = pm.response.json();",
              "    ",
              "    // Proveravamo da li struktura sadrži 'user' objekat",
              "    pm.expect(responseData).to.have.property('user');",
              "    ",
              "    // Validacija konkretnih vrednosti koje ste naveli",
              "    pm.expect(responseData.user.email).to.equal(\"banetest@gmail.com\");",
              "    pm.expect(responseData.user.username).to.equal(\"BaneTest\");",
              "    pm.expect(responseData.user.id).to.equal(59649);",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://conduit-api.bondaracademy.com/api/user",
          "protocol": "https",
          "host": [
            "conduit-api",
            "bondaracademy",
            "com"
          ],
          "path": [
            "api",
            "user"
          ]
        }
      },
      "response": []
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{user_token}}",
        "type": "string"
      }
    ]
  },
